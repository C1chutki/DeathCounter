<Application x:Class="EldenDeathCounter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/EldenDeathCounter;component/Localization/Strings.en.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="AppFontFamily">pack://application:,,,/Assets/Fonts/#Spectral</FontFamily>
            <FontFamily x:Key="HeaderFontFamily">pack://application:,,,/Assets/Fonts/#Cinzel</FontFamily>
            <FontFamily x:Key="MonoFontFamily">pack://application:,,,/Assets/Fonts/#JetBrains Mono</FontFamily>
            <FontFamily x:Key="EmblemFontFamily">pack://application:,,,/Assets/Fonts/#UnifrakturCook</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>

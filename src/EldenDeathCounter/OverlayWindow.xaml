<Window x:Class="EldenDeathCounter.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Border x:Name="OverlayChrome"
            MinWidth="356"
            Background="#E60A1014"
            BorderBrush="#5A3A20"
            BorderThickness="1"
            CornerRadius="7"
            Padding="22,20,22,18">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="OverlayScaleTransform" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="0"
                              Opacity="0.45"
                              Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="DetectionDot"
                             Width="9"
                             Height="9"
                             Fill="#8DA46D"
                             Margin="0,0,10,0" />
                    <TextBlock x:Name="DetectionStatusTextBlock"
                               Text="{DynamicResource Overlay_DetectionStopped}"
                               Foreground="#B0702E"
                               FontFamily="{DynamicResource HeaderFontFamily}"
                               FontSize="12"
                               FontWeight="Bold" />
                </StackPanel>
                <TextBlock x:Name="VersionTextBlock"
                           Grid.Column="1"
                           Text="v1.0.0"
                           Foreground="#8D8780"
                           FontFamily="{DynamicResource HeaderFontFamily}"
                           FontSize="12"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="TotalDeathsLabelTextBlock"
                       Text="{DynamicResource Overlay_TotalDeaths}"
                       Foreground="#B0702E"
                       FontFamily="{DynamicResource HeaderFontFamily}"
                       FontSize="12"
                       FontWeight="Bold"
                       Margin="0,0,0,6" />
            <TextBlock x:Name="CounterTextBlock"
                       Text="Śmierci: 0"
                       Foreground="#D6A1A6"
                       FontSize="26"
                       FontWeight="SemiBold"
                       FontFamily="{DynamicResource AppFontFamily}" />

            <StackPanel x:Name="BossPanel"
                        Visibility="Collapsed"
                        Margin="0,22,0,0">
                <Border x:Name="DividerBorder"
                        Height="1"
                        Background="#2C2E27"
                        Margin="0,0,0,24" />
                <TextBlock x:Name="BossTextBlock"
                           Text=""
                           Foreground="#E8E3DA"
                           FontSize="20"
                           FontWeight="SemiBold"
                           FontFamily="{DynamicResource AppFontFamily}"
                           MaxWidth="620"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           LineHeight="25" />
                <TextBlock x:Name="BossDeathTextBlock"
                           Text=""
                           Foreground="#C9742E"
                           FontFamily="{DynamicResource HeaderFontFamily}"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,6,0,0" />
                <Border x:Name="TimerChrome"
                        Background="#B3000000"
                        BorderBrush="#293522"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,24,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="20"
                                 Height="20"
                                 VerticalAlignment="Center"
                                 Margin="0,0,16,0">
                            <Grid Width="20" Height="20">
                                <Ellipse x:Name="ClockFace"
                                         Stroke="{Binding Foreground, ElementName=TimerTextBlock}"
                                         StrokeThickness="2"
                                         Width="16"
                                         Height="16"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Path x:Name="ClockHands"
                                      Stroke="{Binding Foreground, ElementName=TimerTextBlock}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M10,5 L10,10 L14,13" />
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="TimerTextBlock"
                                   Grid.Column="1"
                                   Text="00:00:00"
                                   Foreground="#D6DBDF"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

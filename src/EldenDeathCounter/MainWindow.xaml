<Window x:Class="EldenDeathCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elden Ring Death Counter"
        Width="1582"
        Height="840"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0B"
        FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#F1EEE7" />
        <SolidColorBrush x:Key="MutedInk" Color="#B8B1A6" />
        <SolidColorBrush x:Key="Gold" Color="#EAC36D" />
        <SolidColorBrush x:Key="Panel" Color="#141414" />
        <SolidColorBrush x:Key="PanelAlt" Color="#191815" />
        <SolidColorBrush x:Key="Secondary" Color="#191919" />
        <SolidColorBrush x:Key="Neutral" Color="#0B0B0B" />
        <SolidColorBrush x:Key="HeaderSurface" Color="#111111" />
        <SolidColorBrush x:Key="HoverSurface" Color="#2D2518" />
        <SolidColorBrush x:Key="AccentBorder" Color="#6F5B36" />
        <SolidColorBrush x:Key="Separator" Color="#3A3122" />
        <SolidColorBrush x:Key="ThumbSurface" Color="#8B744A" />
        <SolidColorBrush x:Key="HistoryCard" Color="#191919" />
        <SolidColorBrush x:Key="DimBorder" Color="#26231E" />
        <SolidColorBrush x:Key="StatusBarSurface" Color="#10100F" />
        <SolidColorBrush x:Key="BorderGold" Color="#4A3D27" />
        <SolidColorBrush x:Key="Danger" Color="#940E0C" />
        <SolidColorBrush x:Key="MonitorGreen" Color="#6EAF7A" />
        <!-- Claude Design accent tokens -->
        <SolidColorBrush x:Key="Gold2" Color="#E8C66A" />
        <SolidColorBrush x:Key="Grace" Color="#6EAF7A" />
        <SolidColorBrush x:Key="Faint" Color="#5F543E" />
        <SolidColorBrush x:Key="Line2" Color="#3A3122" />
        <SolidColorBrush x:Key="Ink2" Color="#B9AD90" />
        <SolidColorBrush x:Key="RailActiveFill" Color="#221C10" />
        <LinearGradientBrush x:Key="GoldPill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E8C66A" Offset="0" />
            <GradientStop Color="#B8902F" Offset="1" />
        </LinearGradientBrush>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Gold}" />
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedInk}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderGold}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#171717" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverSurface}" />
                    <Setter Property="Foreground" Value="{DynamicResource Gold}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Gold}" />
            <Setter Property="Foreground" Value="#20160D" />
            <Setter Property="BorderBrush" Value="{DynamicResource Gold}" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#260C0C" />
            <Setter Property="BorderBrush" Value="#C64B42" />
            <Setter Property="Foreground" Value="#FFD1C9" />
        </Style>

        <Style x:Key="MiniEditButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#D2A099" />
            <Setter Property="BorderBrush" Value="#5D403C" />
            <Setter Property="Background" Value="#1A1414" />
        </Style>

        <Style x:Key="GameShortcutButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="MonitorToggleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="{DynamicResource Monitor_Start}" />
            <Setter Property="Background" Value="#17301F" />
            <Setter Property="BorderBrush" Value="{StaticResource MonitorGreen}" />
            <Setter Property="Foreground" Value="#D8FFE0" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="FontSize" Value="18" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#21462C" />
                </Trigger>
                <DataTrigger Binding="{Binding IsDetectionRunning}" Value="True">
                    <Setter Property="Content" Value="{DynamicResource Monitor_Stop}" />
                    <Setter Property="Background" Value="#3A1010" />
                    <Setter Property="BorderBrush" Value="#D9574F" />
                    <Setter Property="Foreground" Value="#FFD6D1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonitorStatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Fill" Value="#665E52" />
            <Setter Property="Stroke" Value="#95866F" />
            <Setter Property="StrokeThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDetectionRunning}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource MonitorGreen}" />
                    <Setter Property="Stroke" Value="#B9E7BE" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource HeaderSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Gold}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Gold}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBorder}" />
        </Style>

        <Style x:Key="DarkComboBoxItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="#050505" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Margin="3,2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverSurface}" />
                                <Setter Property="Foreground" Value="{DynamicResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#171717" />
                                <Setter Property="Foreground" Value="{DynamicResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#050505" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Gold}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="ToggleBorder"
                                                Background="#050505"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <ContentPresenter x:Name="ContentSite"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  RecognizesAccessKey="True" />
                                                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource Ink}"
                                                      Width="8"
                                                      Height="4"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      Stretch="Fill" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource HeaderSurface}" />
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Gold}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource HeaderSurface}" />
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Gold}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False" />
                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      Background="Transparent"
                                      Margin="0,4,0,0"
                                      SnapsToDevicePixels="True">
                                    <Border Background="#050505"
                                            BorderBrush="{DynamicResource Gold}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="2">
                                        <ScrollViewer>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Popup" Property="MinHeight" Value="36" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#050505" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#050505" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2D2518" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#EAC36D" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F1EEE7" />
            </Style.Resources>
        </Style>

        <Style x:Key="ModernScrollBarButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="{DynamicResource ThumbSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Gold}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Margin="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  Direction="270"
                                                  Opacity="0.22"
                                                  ShadowDepth="0"
                                                  Color="#EAC36D" />
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#C09B5A" />
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#FFD98A" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Gold}" />
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#FFE7A8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#11100E" />
            <Setter Property="BorderBrush" Value="#2D281E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="16" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Margin="3"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border Width="2"
                                        Background="#3A3122"
                                        CornerRadius="1"
                                        HorizontalAlignment="Center"
                                        Margin="0,8" />
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="True"
                                       Margin="0,4">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                      Style="{StaticResource ModernScrollBarButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                      Style="{StaticResource ModernScrollBarButton}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="16" />
                    <Setter Property="MinHeight" Value="16" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Margin="3"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Border Height="2"
                                                Background="#3A3122"
                                                CornerRadius="1"
                                                VerticalAlignment="Center"
                                                Margin="8,0" />
                                        <Track x:Name="PART_Track"
                                               Margin="4,0">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                                              Style="{StaticResource ModernScrollBarButton}" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                                              Style="{StaticResource ModernScrollBarButton}" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#171510" />
                    <Setter Property="BorderBrush" Value="#4A3D27" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="24,18" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,4,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A3020" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Gold}" />
                                <Setter Property="Foreground" Value="{DynamicResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#241F17" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Claude Design chrome styles ===== -->
        <Style x:Key="RailNavButton" TargetType="RadioButton">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="Foreground" Value="{DynamicResource MutedInk}" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14D9B45A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RailActiveFill}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Gold}" />
                                <Setter Property="Foreground" Value="{DynamicResource Gold2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailIconButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedInk}" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14D9B45A" />
                                <Setter Property="Foreground" Value="{DynamicResource Gold2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GamePill" TargetType="Button">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource MutedInk}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Gold2}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GamePillActive" TargetType="Button" BasedOn="{StaticResource GamePill}">
            <Setter Property="Foreground" Value="#1A1308" />
            <Setter Property="Background" Value="{StaticResource GoldPill}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="TopStatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="#5A5345" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDetectionRunning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Gold2}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#D9B45A" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardCounterInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="95" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Background" Value="#070503" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderGold}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashboardCircleButton" TargetType="Button">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="60" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#070503" />
            <Setter Property="BorderBrush" Value="#6A5425" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="30">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Gold}" />
                                <Setter Property="Foreground" Value="{DynamicResource Gold2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardResetCircleButton" TargetType="Button" BasedOn="{StaticResource DashboardCircleButton}">
            <Setter Property="BorderBrush" Value="#7A2E1D" />
            <Setter Property="Foreground" Value="#E15A3D" />
        </Style>

        <Style x:Key="DashboardActionCaption" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>

        <Style x:Key="EncounterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="58" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#0C0804" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderGold}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedInk}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="EncounterGoldButton" TargetType="Button" BasedOn="{StaticResource EncounterButton}">
            <Setter Property="Width" Value="170" />
            <Setter Property="Background" Value="{DynamicResource Gold}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Gold}" />
            <Setter Property="Foreground" Value="#060503" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="78" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="SidebarBorder" Grid.RowSpan="2" Background="{DynamicResource Secondary}" BorderBrush="{DynamicResource DimBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Emblem -->
                <Border Width="44" Height="44" Margin="0,16,0,27" CornerRadius="22"
                        BorderBrush="{DynamicResource Gold}" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#D9B45A" />
                    </Border.Effect>
                    <TextBlock Text="D"
                               FontFamily="{DynamicResource EmblemFontFamily}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Gold2}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.85" Color="#3B0000" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                    <RadioButton GroupName="Navigation" IsChecked="True" Tag="0" Content="&#x25A6;"
                                 Style="{StaticResource RailNavButton}"
                                 ToolTip="{DynamicResource Section_Dashboard}"
                                 Checked="NavigationRadio_Checked" />
                    <RadioButton GroupName="Navigation" Tag="1" Content="&#x25CE;"
                                 Style="{StaticResource RailNavButton}"
                                 ToolTip="{DynamicResource Section_Detection}"
                                 Checked="NavigationRadio_Checked" />
                    <RadioButton GroupName="Navigation" Tag="2" Content="&#x25C7;"
                                 Style="{StaticResource RailNavButton}"
                                 ToolTip="{DynamicResource Section_Bosses}"
                                 Checked="NavigationRadio_Checked" />
                    <RadioButton GroupName="Navigation" Tag="3" Content="&#x2630;"
                                 Style="{StaticResource RailNavButton}"
                                 ToolTip="{DynamicResource Section_Settings}"
                                 Checked="NavigationRadio_Checked" />
                </StackPanel>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="v1.11.4"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="8.5"
                               Foreground="{DynamicResource Faint}"
                               HorizontalAlignment="Center"
                               Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="HeaderBorder" Grid.Column="1" Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1" Padding="32,0" Height="60">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Game pills -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DarkSouls1Button" Content="DS"
                            Style="{StaticResource GamePill}"
                            Click="DarkSouls1Button_Click" />
                    <Button x:Name="DarkSouls2Button" Content="DS2"
                            Style="{StaticResource GamePill}"
                            Click="DarkSouls2Button_Click" />
                    <Button x:Name="DarkSouls3Button" Content="DS3"
                            Style="{StaticResource GamePill}"
                            Click="DarkSouls3Button_Click" />
                    <Button x:Name="EldenRingButton" Content="ER"
                            Style="{StaticResource GamePillActive}"
                            Click="EldenRingButton_Click" />
                </StackPanel>

                <!-- Section title -->
                <TextBlock x:Name="SectionTitleText" Grid.Column="1"
                           Text="DASHBOARD"
                           FontFamily="{DynamicResource HeaderFontFamily}"
                           FontSize="13"
                           Foreground="{DynamicResource MutedInk}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <!-- Live status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource TopStatusDot}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding DetectionStatus}"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Ink}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="|" Foreground="{DynamicResource Gold2}" Margin="9,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="LAST"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Gold2}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LastDetectedDeathText}"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Ink}"
                               Margin="4,0,20,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Elden Ring Death Counter"
                               FontFamily="{DynamicResource HeaderFontFamily}"
                               FontSize="11"
                               Foreground="{DynamicResource Faint}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs"
                    Grid.Column="1"
                    Grid.Row="1"
                    Background="{DynamicResource Neutral}"
                    BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Style>
            </TabControl.Resources>

            <TabItem Header="Dashboard">
                <Grid x:Name="DashboardStage" Margin="38,0,34,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="96" />
                    </Grid.RowDefinitions>

                    <Grid HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="YOU HAVE DIED"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#A7512E"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding StatusDeathCountText}"
                                   FontFamily="{DynamicResource HeaderFontFamily}"
                                   FontSize="172"
                                   FontWeight="Bold"
                                   LineHeight="172"
                                   Foreground="#FFF0D2"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,-6,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="22"
                                                  ShadowDepth="0"
                                                  Opacity="0.28"
                                                  Color="#D9B45A" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Grid.Row="2"
                                   Text="TIMES"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedInk}"
                                   HorizontalAlignment="Center"
                                   Margin="0,-12,0,28" />

                        <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SET COUNTER"
                                       Style="{StaticResource LabelText}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding ManualCounterText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DashboardCounterInput}" />
                        </Grid>

                        <Grid Grid.Row="4" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Button Content="-"
                                        Command="{Binding SubtractDeathCommand}"
                                        Style="{StaticResource DashboardCircleButton}" />
                                <TextBlock Text="F9" Style="{StaticResource DashboardActionCaption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Button Content="SET"
                                        Command="{Binding SetCounterCommand}"
                                        FontSize="11"
                                        Style="{StaticResource DashboardCircleButton}" />
                                <TextBlock Text="SET COUNTER" Style="{StaticResource DashboardActionCaption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <Button Content="+"
                                        Command="{Binding AddDeathCommand}"
                                        Style="{StaticResource DashboardCircleButton}"
                                        BorderBrush="{DynamicResource Gold}" />
                                <TextBlock Text="F8" Style="{StaticResource DashboardActionCaption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <Button Content="R"
                                        Command="{Binding ResetCounterCommand}"
                                        FontSize="24"
                                        Style="{StaticResource DashboardResetCircleButton}" />
                                <TextBlock Text="RESET COUNTER" Style="{StaticResource DashboardActionCaption}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border x:Name="ActiveEncounterBar"
                            Grid.Row="1"
                            Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource BorderGold}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="26,18,18,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="58" Height="58">
                                <Border Width="40"
                                        Height="40"
                                        BorderBrush="{DynamicResource Gold}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock Text="{Binding ActiveBossDeathCountText}"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Gold}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource Common_ActiveEncounter}"
                                               Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding BossesActiveStartedText}"
                                               Style="{StaticResource LabelText}"
                                               Margin="22,0,0,0" />
                                </StackPanel>
                                <TextBox Grid.Row="1"
                                         Text="{Binding BossNameText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderBrush="{DynamicResource BorderGold}"
                                         BorderThickness="0,0,0,1"
                                         Padding="0,0,0,6"
                                         FontFamily="{DynamicResource AppFontFamily}"
                                         FontSize="16"
                                         Foreground="{DynamicResource Ink}" />
                            </Grid>

                            <Button Grid.Column="4"
                                    Content="SET"
                                    Command="{Binding SetActiveBossCommand}"
                                    Style="{StaticResource EncounterButton}" />
                            <Button Grid.Column="6"
                                    Content="&#x2726; BOSS DEFEATED"
                                    Command="{Binding BossDefeatedCommand}"
                                    Style="{StaticResource EncounterGoldButton}" />
                            <Button Grid.Column="8"
                                    Content="SKIP"
                                    Command="{Binding SkipBossCommand}"
                                    Style="{StaticResource EncounterButton}" />
                        </Grid>
                    </Border>

                        <Border Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="74" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Common_ActiveEncounter}" Style="{StaticResource LabelText}" />
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding ActiveBossDeathCountText}"
                                                   FontFamily="{DynamicResource HeaderFontFamily}"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Gold}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                        <TextBox Text="{Binding BossNameText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource AppFontFamily}"
                                                 FontSize="26"
                                                 FontWeight="Bold"
                                                 Padding="0,2,8,6"
                                                 BorderThickness="0,0,0,1" />
                                    </DockPanel>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="-"
                                        Command="{Binding SubtractDeathCommand}"
                                        Width="58"
                                        Height="58"
                                        FontSize="28"
                                        Margin="20,0,8,0" />
                                <Button Grid.Column="2"
                                        Content="+"
                                        Command="{Binding AddDeathCommand}"
                                        Width="58"
                                        Height="58"
                                        FontSize="28"
                                        Margin="0,0,16,0" />
                                <Button Grid.Column="3"
                                        Content="{DynamicResource Dash_BossDefeated}"
                                        Command="{Binding BossDefeatedCommand}"
                                        Style="{StaticResource GoldButton}"
                                        MinWidth="210"
                                        Margin="0,0,8,0" />
                                <Button Grid.Column="4"
                                        Content="{DynamicResource Dash_Skip}"
                                        Command="{Binding SkipBossCommand}"
                                        Style="{StaticResource DangerButton}"
                                        MinWidth="94"
                                        Margin="0,0,16,0" />
                                <Button Grid.Column="5"
                                        Content="✎"
                                        Command="{Binding SetActiveBossCommand}"
                                        FontSize="22" />
                            </Grid>
                        </Border>

                    </Grid>
            </TabItem>

            <TabItem Header="Detection">
                <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource PanelBorder}" BorderThickness="1,3,1,1" Margin="0,0,0,30">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="98" Height="98" BorderBrush="#5A4B31" BorderThickness="3" CornerRadius="49" Margin="0,0,28,0">
                                    <TextBlock Text="◎" FontSize="44" Foreground="{DynamicResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Detect_SystemEngine}" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding DetectionStatus}" Foreground="{DynamicResource Gold}" FontFamily="{DynamicResource HeaderFontFamily}" FontSize="38" FontWeight="Bold" Margin="0,4,0,4" />
                                    <TextBlock Text="{DynamicResource Detect_Monitoring}" Style="{StaticResource MutedText}" FontSize="18" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Command="{Binding ToggleDetectionCommand}"
                                        Style="{StaticResource MonitorToggleButton}"
                                        Width="236"
                                        Height="64"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,26">
                                        <Button DockPanel.Dock="Right"
                                                Content="{DynamicResource Detect_Clear}"
                                                Command="{Binding ClearDetectionLogCommand}"
                                                Padding="10,4"
                                                MinHeight="28"
                                                BorderThickness="0" />
                                        <Button DockPanel.Dock="Right"
                                                Content="{DynamicResource Detect_Diag10m}"
                                                Command="{Binding StartDiagnosticsCommand}"
                                                Padding="10,4"
                                                MinHeight="28"
                                                Margin="0,0,8,0"
                                                BorderThickness="0" />
                                        <TextBlock Text="{DynamicResource Detect_Log}" FontFamily="{DynamicResource HeaderFontFamily}" FontSize="30" FontWeight="Bold" />
                                    </DockPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding DetectionLogEntries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="LogEntryBorder"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            CornerRadius="7"
                                                            Padding="0"
                                                            Margin="0,0,0,14">
                                                        <TextBlock x:Name="LogEntryText"
                                                                   Text="{Binding DisplayText}"
                                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                                   Foreground="{DynamicResource MutedInk}"
                                                                   TextWrapping="Wrap" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsEvent}" Value="True">
                                                            <Setter TargetName="LogEntryBorder" Property="Background" Value="#211D17" />
                                                            <Setter TargetName="LogEntryBorder" Property="BorderBrush" Value="{DynamicResource Gold}" />
                                                            <Setter TargetName="LogEntryBorder" Property="BorderThickness" Value="3,0,0,0" />
                                                            <Setter TargetName="LogEntryBorder" Property="Padding" Value="14,8" />
                                                            <Setter TargetName="LogEntryText" Property="Foreground" Value="{DynamicResource Gold}" />
                                                            <Setter TargetName="LogEntryText" Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Bosses">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="48,38">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Bosses_Title}"
                                           FontFamily="{DynamicResource HeaderFontFamily}"
                                           FontSize="48"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Gold}" />
                                <TextBlock Text="{DynamicResource Bosses_Subtitle1}"
                                           Style="{StaticResource MutedText}"
                                           FontSize="20"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0" />
                                <TextBlock Text="{DynamicResource Bosses_Subtitle2}"
                                           Style="{StaticResource MutedText}"
                                           FontSize="20"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource HeaderSurface}"
                                    BorderBrush="{DynamicResource BorderGold}"
                                    BorderThickness="0,0,0,1"
                                    Padding="16,10"
                                    VerticalAlignment="Top">
                                <Grid>
                                    <TextBox Text="{Binding BossSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontSize="18" />
                                    <TextBlock Text="{DynamicResource Bosses_SearchPlaceholder}"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontSize="18"
                                               Foreground="#6F675D"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BossSearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,0,0,46">
                            <TextBlock Text="{DynamicResource Bosses_CurrentEncounter}"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,0,0,20" />
                            <Border Background="{DynamicResource PanelAlt}"
                                    BorderBrush="#7C653A"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    Padding="34">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="250" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Common_ActiveEncounter}"
                                                   Style="{StaticResource LabelText}"
                                                   Margin="0,0,0,22" />
                                        <TextBlock Text="{Binding BossesActiveName}"
                                                   FontFamily="{DynamicResource HeaderFontFamily}"
                                                   FontSize="42"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding BossesActiveStartedText}"
                                                   Style="{StaticResource MutedText}"
                                                   FontStyle="Italic"
                                                   FontSize="16"
                                                   Margin="0,18,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="#232220"
                                            BorderBrush="#3F382B"
                                            BorderThickness="1"
                                            CornerRadius="11"
                                            Padding="26"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Bosses_DeathsRecorded}"
                                                       FontFamily="{DynamicResource AppFontFamily}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Ink}"
                                                       Margin="0,0,0,14" />
                                            <TextBlock Text="{Binding BossesActiveAttemptsText}"
                                                       Foreground="{DynamicResource Gold}"
                                                       FontFamily="{DynamicResource HeaderFontFamily}"
                                                       FontSize="34"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Bosses_ConqueredFoes}"
                                           Style="{StaticResource LabelText}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="{DynamicResource Bosses_AddRecord}"
                                        Command="{Binding OpenAddBossHistoryEditorCommand}"
                                        Style="{StaticResource GoldButton}"
                                        MinWidth="140"
                                        VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,24">
                                <TextBlock Text="{DynamicResource Bosses_SortBy}"
                                           Style="{StaticResource MutedText}"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <ComboBox ItemsSource="{Binding BossSortModeOptions}"
                                          SelectedValue="{Binding SelectedBossSortMode, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource DarkComboBox}"
                                          FontSize="16"
                                          Width="170" />
                                <TextBlock Text="{DynamicResource Bosses_Direction}"
                                           Style="{StaticResource MutedText}"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="24,0,10,0" />
                                <ComboBox ItemsSource="{Binding BossSortDirectionOptions}"
                                          SelectedValue="{Binding SelectedBossSortDirection, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource DarkComboBox}"
                                          FontSize="16"
                                          Width="170" />
                            </StackPanel>
                            <TextBlock Text="{Binding DefeatedBossesEmptyText}"
                                       Style="{StaticResource MutedText}"
                                       FontStyle="Italic"
                                       Margin="0,0,0,16" />
                            <ItemsControl ItemsSource="{Binding DefeatedBosses}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="320"
                                                MinHeight="184"
                                                Background="{DynamicResource Panel}"
                                                BorderBrush="#3A3326"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Margin="0,0,18,18">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="16"
                                                                  Direction="270"
                                                                  ShadowDepth="2"
                                                                  Opacity="0.4"
                                                                  Color="#000000" />
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Height="4" CornerRadius="14,14,0,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#5A4A2C" Offset="0" />
                                                            <GradientStop Color="#EAC36D" Offset="0.5" />
                                                            <GradientStop Color="#5A4A2C" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="18,16,18,18">
                                                    <DockPanel Margin="0,0,0,16">
                                                        <Border DockPanel.Dock="Right"
                                                                Background="#241E13"
                                                                BorderBrush="#5A4A2C"
                                                                BorderThickness="1"
                                                                CornerRadius="9"
                                                                Padding="9,3"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding NumberText}"
                                                                       FontFamily="{DynamicResource AppFontFamily}"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       Foreground="#D2A099" />
                                                        </Border>
                                                        <Border Background="#2A2113"
                                                                BorderBrush="{DynamicResource Gold}"
                                                                BorderThickness="1"
                                                                CornerRadius="9"
                                                                Padding="10,4"
                                                                HorizontalAlignment="Left">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="✦"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource Gold}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0" />
                                                                <TextBlock Text="{DynamicResource Bosses_Felled}"
                                                                           FontFamily="{DynamicResource HeaderFontFamily}"
                                                                           FontSize="12"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource Gold}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontFamily="{DynamicResource HeaderFontFamily}"
                                                               FontSize="24"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Ink}"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                                        <Border Background="#1B1813"
                                                                BorderBrush="#2F2A20"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="10,4"
                                                                Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding AttemptsText}"
                                                                       FontFamily="{DynamicResource AppFontFamily}"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource Ink}" />
                                                        </Border>
                                                        <Border Background="#1B1813"
                                                                BorderBrush="#2F2A20"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="10,4">
                                                            <TextBlock Text="{Binding FightDurationText}"
                                                                       FontFamily="{DynamicResource AppFontFamily}"
                                                                       FontSize="13"
                                                                       Foreground="#A27A72"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                    </StackPanel>
                                                    <DockPanel Margin="0,16,0,0" LastChildFill="False">
                                                        <Button DockPanel.Dock="Right"
                                                                Content="{DynamicResource Common_Edit}"
                                                                Command="{Binding DataContext.OpenBossHistoryEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource MiniEditButton}"
                                                                VerticalAlignment="Center" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding CompletedBy}"
                                                                       Style="{StaticResource LabelText}"
                                                                       FontSize="11"
                                                                       Foreground="#8F877A" />
                                                            <TextBlock Text="{Binding RecordedText}"
                                                                       FontFamily="{DynamicResource AppFontFamily}"
                                                                       FontSize="12"
                                                                       Foreground="#A27A72"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="48,38">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,34">
                            <TextBlock Text="{DynamicResource Settings_Title}"
                                       FontFamily="{DynamicResource HeaderFontFamily}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Gold}"
                                       Margin="0,0,22,0" />
                            <TextBlock Text="{DynamicResource Settings_Subtitle}"
                                       Style="{StaticResource MutedText}"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- OVERLAY -->
                            <Border Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_OverlaySection}" Style="{StaticResource LabelText}" Margin="0,0,0,24" />
                                    <CheckBox Content="{DynamicResource Settings_ShowOverlay}" IsChecked="{Binding OverlayEnabled}" Margin="0,0,0,4" />
                                    <TextBlock Text="{DynamicResource Settings_ShowOverlayDesc}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontStyle="Italic" Margin="0,0,0,22" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings_OverlayX}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" />
                                            <TextBox Text="{Binding OverlayXText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Settings_OverlayY}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" />
                                            <TextBox Text="{Binding OverlayYText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- DETECTION -->
                            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_DetectionSection}" Style="{StaticResource LabelText}" Margin="0,0,0,24" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings_DetectionInterval}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" />
                                            <TextBox Text="{Binding DetectionIntervalMsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,18" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Settings_Cooldown}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" />
                                            <TextBox Text="{Binding DetectionCooldownSecondsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,18" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Settings_Sensitivity}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" />
                                    <TextBox Text="{Binding DetectionSensitivityText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,18" />
                                    <TextBlock Text="{DynamicResource Settings_CaptureRegion}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" />
                                    <ComboBox ItemsSource="{Binding CaptureTargetOptions}"
                                              SelectedValue="{Binding SelectedCaptureTargetValue, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource DarkComboBox}"
                                              Margin="0,6,0,14" />
                                    <CheckBox Content="{DynamicResource Settings_StartDetectionOnLaunch}" IsChecked="{Binding DetectionEnabledOnStartup}" />
                                    <CheckBox Content="{DynamicResource Settings_AutoReadBossName}" IsChecked="{Binding AutoDetectBossNames}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- CHARACTER & SAVE GAME -->
                            <Border Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_CharacterSection}" Style="{StaticResource LabelText}" Margin="0,0,0,16" />
                                    <TextBlock Text="{DynamicResource Settings_CharacterDesc}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" Margin="0,0,0,12" />
                                    <TextBlock Text="{DynamicResource Settings_CharacterName}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding CharacterProfileNameText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                                    <Button Content="{DynamicResource Settings_UseProfile}"
                                            Command="{Binding ApplyCharacterProfileCommand}"
                                            Style="{StaticResource GoldButton}" />
                                </StackPanel>
                            </Border>

                            <!-- LANGUAGE -->
                            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_LanguageSection}" Style="{StaticResource LabelText}" Margin="0,0,0,16" />
                                    <TextBlock Text="{DynamicResource Settings_LanguageDesc}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" Margin="0,0,0,12" />
                                    <ComboBox ItemsSource="{Binding GameLanguageOptions}"
                                              SelectedValue="{Binding SelectedGameLanguageValue, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource DarkComboBox}" />
                                    <TextBlock Text="{DynamicResource Settings_AppLanguageSection}" Style="{StaticResource LabelText}" Margin="0,24,0,16" />
                                    <TextBlock Text="{DynamicResource Settings_AppLanguageDesc}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" Margin="0,0,0,12" />
                                    <ComboBox ItemsSource="{Binding AppLanguageOptions}"
                                              SelectedValue="{Binding SelectedAppLanguageValue, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource DarkComboBox}" />
                                </StackPanel>
                            </Border>

                            <!-- HOTKEYS -->
                            <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_HotkeysSection}" Style="{StaticResource LabelText}" Margin="0,0,0,20" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="84" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource Settings_HotkeyAddDeath}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding ManualAddHotkeyText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="0,0,0,14" />
                                        <TextBlock Grid.Row="1" Text="{DynamicResource Settings_HotkeySubtractDeath}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ManualSubtractHotkeyText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="0,0,0,14" />
                                        <TextBlock Grid.Row="2" Text="{DynamicResource Settings_HotkeyBossKill}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ManualBossDefeatedHotkeyText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="0,0,0,14" />
                                        <TextBlock Grid.Row="3" Text="{DynamicResource Settings_HotkeyToggleOverlay}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OverlayToggleHotkeyText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="0,0,0,14" />
                                        <TextBlock Grid.Row="4" Text="{DynamicResource Common_ToggleDetection}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DetectionToggleHotkeyText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="0,0,0,14" />
                                        <TextBlock Grid.Row="5" Text="{DynamicResource Common_SkipBoss}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding BossSkipHotkeyText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- PROFILE / SAVE GAME -->
                        <Border Grid.Row="3" Style="{StaticResource PanelBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_ProfileSection}" Style="{StaticResource LabelText}" Margin="0,0,0,16" />
                                    <TextBlock Text="{DynamicResource Settings_ProfileDesc}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" Margin="0,0,0,12" />
                                    <TextBox Text="{Binding DataFolderPathText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{DynamicResource Settings_SaveSettings}"
                                        Command="{Binding SaveSettingsCommand}"
                                        Style="{StaticResource GoldButton}"
                                        Margin="24,28,0,0"
                                        VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Column="1"
                Grid.Row="1"
                Background="#A0000000"
                Visibility="{Binding IsBossHistoryEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="430"
                    Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource BorderGold}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28"
                                      Direction="270"
                                      ShadowDepth="3"
                                      Opacity="0.55"
                                      Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding BossHistoryEditorTitle}"
                               Style="{StaticResource LabelText}"
                               Margin="0,0,0,18" />
                    <TextBlock Text="{DynamicResource Editor_Name}"
                               Style="{StaticResource MutedText}"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontWeight="Bold" />
                    <TextBox Text="{Binding BossEditNameText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Editor_Attempts}"
                                       Style="{StaticResource MutedText}"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       FontWeight="Bold" />
                            <TextBox Text="{Binding BossEditAttemptsText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,14" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Editor_Duration}"
                                       Style="{StaticResource MutedText}"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       FontWeight="Bold" />
                            <TextBox Text="{Binding BossEditDurationText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,14" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource Editor_RecordedAt}"
                               Style="{StaticResource MutedText}"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontWeight="Bold" />
                    <TextBox Text="{Binding BossEditRecordedAtText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,14" />
                    <TextBlock Text="{DynamicResource Editor_CompletedBy}"
                               Style="{StaticResource MutedText}"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontWeight="Bold" />
                    <TextBox Text="{Binding BossEditCompletedByText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,22" />
                    <DockPanel LastChildFill="False">
                        <Button Content="{DynamicResource Common_Delete}"
                                Command="{Binding DeleteBossHistoryEditorCommand}"
                                Style="{StaticResource DangerButton}"
                                MinWidth="100"
                                Margin="0,0,12,0"
                                Visibility="{Binding CanDeleteBossHistoryEntry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="{DynamicResource Common_Cancel}"
                                Command="{Binding CancelBossHistoryEditorCommand}"
                                MinWidth="100"
                                Margin="0,0,12,0" />
                        <Button DockPanel.Dock="Right"
                                Content="{DynamicResource Common_Save}"
                                Command="{Binding SaveBossHistoryEditorCommand}"
                                IsDefault="True"
                                Style="{StaticResource GoldButton}"
                                MinWidth="118" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>

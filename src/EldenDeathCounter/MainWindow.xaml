                    <ScrollViewer Panel.ZIndex="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="38,0,34,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="YOU HAVE DIED"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#A7512E"
                                   HorizontalAlignment="Center" />
                        <Viewbox Grid.Row="2"
                                 HorizontalAlignment="Center"
                                 MaxHeight="172"
                                 StretchDirection="DownOnly">
                        <Grid IsHitTestVisible="False">
                            <TextBlock x:Name="DashboardCountGlow"
                                       Text="{Binding StatusDeathCountText}"
                                       FontFamily="{DynamicResource HeaderFontFamily}"
                                       FontSize="172"
                                       FontWeight="Bold"
                                       LineHeight="172"
                                       Foreground="#F8C794"
                                       Opacity="0.82"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="156"
                                                      ShadowDepth="0"
                                                      Opacity="1"
                                                      Color="#C9742E" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="DashboardCountTextBlur"
                                       Text="{Binding StatusDeathCountText}"
                                       FontFamily="{DynamicResource HeaderFontFamily}"
                                       FontSize="172"
                                       FontWeight="Bold"
                                       LineHeight="172"
                                       Foreground="#F8C794"
                                       Opacity="0.46"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center">
                                <TextBlock.Effect>
                                    <BlurEffect Radius="10" KernelType="Gaussian" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusDeathCountText}"
                                       FontFamily="{DynamicResource HeaderFontFamily}"
                                       FontSize="172"
                                       FontWeight="Bold"
                                       LineHeight="172"
                                       Foreground="#FBD9B0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="44"
                                                      ShadowDepth="0"
                                                      Opacity="0.62"
                                                      Color="#C9742E" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                        </Viewbox>
                        <TextBlock Grid.Row="4"
                                   Text="TIMES"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedInk}"
                                   HorizontalAlignment="Center" />

                        <Grid Grid.Row="6" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SET COUNTER"
                                       Style="{StaticResource LabelText}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding ManualCounterText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DashboardCounterInput}" />
                        </Grid>

                        <Grid Grid.Row="8" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Button Content="-"
                                        Command="{Binding SubtractDeathCommand}"
                                        Style="{StaticResource DashboardCircleButton}" />
                                <TextBlock Text="F8" Style="{StaticResource DashboardActionCaption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Button Content="SET"
                                        Command="{Binding SetCounterCommand}"
                                        FontSize="11"
                                        Style="{StaticResource DashboardCircleButton}" />
                                <TextBlock Text="SET COUNTER" Style="{StaticResource DashboardActionCaption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <Button Content="+"
                                        Command="{Binding AddDeathCommand}"
                                        Style="{StaticResource DashboardCircleButton}" />
                                <TextBlock Text="F9" Style="{StaticResource DashboardActionCaption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <Button Command="{Binding ResetCounterCommand}"
                                        Style="{StaticResource DashboardCircleButton}">
                                    <Rectangle Width="50" Height="50" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://siteoforigin:,,,/Assets/Icons/Reset.png"
                                                        Stretch="Uniform"
                                                        Viewbox="0.28,0.28,0.44,0.44" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Button>
                                <TextBlock Text="RESET COUNTER" Style="{StaticResource DashboardActionCaption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="8">
                                <Button Command="{Binding ToggleDetectionCommand}"
                                        Style="{StaticResource DashboardDetectionToggleButton}" />
                                <TextBlock Text="F6 DETECTION" Style="{StaticResource DashboardActionCaption}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border x:Name="ActiveEncounterBar"
                            Grid.Row="1"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderGold}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="26,18,18,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="72" Height="72">
                                <Border Width="50"
                                        Height="50"
                                        BorderBrush="{DynamicResource Gold}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock Text="{Binding ActiveBossDeathCountText}"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Gold}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource Common_ActiveEncounter}"
                                               Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding BossesActiveStartedText}"
                                               Style="{StaticResource LabelText}"
                                               Margin="22,0,0,0" />
                                </StackPanel>
                                <TextBox Grid.Row="1"
                                         Text="{Binding BossNameText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderBrush="{DynamicResource BorderGold}"
                                         BorderThickness="0,0,0,1"
                                         Padding="0,0,0,6"
                                         FontFamily="{DynamicResource AppFontFamily}"
                                         FontSize="16"
                                         Foreground="{DynamicResource Ink}" />
                            </Grid>

                            <Button Grid.Column="4"
                                    Content="-"
                                    Command="{Binding SubtractDeathCommand}"
                                    Style="{StaticResource EncounterButton}" />
                            <Button Grid.Column="6"
                                    Content="+"
                                    Command="{Binding AddDeathCommand}"
                                    Style="{StaticResource EncounterButton}" />
                            <Button Grid.Column="8"
                                    Content="SET"
                                    Command="{Binding SetActiveBossCommand}"
                                    Style="{StaticResource EncounterButton}" />
                            <Button Grid.Column="10"
                                    Content="&#x2726; BOSS DEFEATED"
                                    Command="{Binding BossDefeatedCommand}"
                                    Style="{StaticResource EncounterGoldButton}" />
                            <Button Grid.Column="12"
                                    Content="SKIP"
                                    Command="{Binding SkipBossCommand}"
                                    Style="{StaticResource EncounterButton}" />
                        </Grid>
                    </Border>

                        <Border Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="74" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Common_ActiveEncounter}" Style="{StaticResource LabelText}" />
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding ActiveBossDeathCountText}"
                                                   FontFamily="{DynamicResource HeaderFontFamily}"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Gold}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                        <TextBox Text="{Binding BossNameText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource AppFontFamily}"
                                                 FontSize="26"
                                                 FontWeight="Bold"
                                                 Padding="0,2,8,6"
                                                 BorderThickness="0,0,0,1" />
                                    </DockPanel>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="-"
                                        Command="{Binding SubtractDeathCommand}"
                                        Width="58"
                                        Height="58"
                                        FontSize="28"
                                        Margin="20,0,8,0" />
                                <Button Grid.Column="2"
                                        Content="+"
                                        Command="{Binding AddDeathCommand}"
                                        Width="58"
                                        Height="58"
                                        FontSize="28"
                                        Margin="0,0,16,0" />
                                <Button Grid.Column="3"
                                        Content="{DynamicResource Dash_BossDefeated}"
                                        Command="{Binding BossDefeatedCommand}"
                                        Style="{StaticResource GoldButton}"
                                        MinWidth="210"
                                        Margin="0,0,8,0" />
                                <Button Grid.Column="4"
                                        Content="{DynamicResource Dash_Skip}"
                                        Command="{Binding SkipBossCommand}"
                                        Style="{StaticResource DangerButton}"
                                        MinWidth="94"
                                        Margin="0,0,16,0" />
                                <Button Grid.Column="5"
                                        Content="✎"
                                        Command="{Binding SetActiveBossCommand}"
                                        FontSize="22" />
                            </Grid>
                        </Border>

                    </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Detection">
                <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource PanelBorder}" BorderThickness="1,3,1,1" Margin="0,0,0,30">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="98" Height="98" BorderBrush="#5E3E22" BorderThickness="3" CornerRadius="49" Margin="0,0,28,0">
                                    <TextBlock Text="◎" FontSize="44" Foreground="{DynamicResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Detect_SystemEngine}" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding DetectionStatus}" Foreground="{DynamicResource Gold}" FontFamily="{DynamicResource HeaderFontFamily}" FontSize="38" FontWeight="Bold" Margin="0,4,0,4" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{DynamicResource Detect_Monitoring}" Style="{StaticResource MutedText}" FontSize="18" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Command="{Binding ToggleDetectionCommand}"
                                        Style="{StaticResource MonitorToggleButton}"
                                        MinWidth="180"
                                        Height="64"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,26">
                                        <Button DockPanel.Dock="Right"
                                                Content="{DynamicResource Detect_Clear}"
                                                Command="{Binding ClearDetectionLogCommand}"
                                                Padding="10,4"
                                                MinHeight="28"
                                                BorderThickness="0" />
                                        <Button DockPanel.Dock="Right"
                                                Content="{DynamicResource Detect_Diag10m}"
                                                Command="{Binding StartDiagnosticsCommand}"
                                                Padding="10,4"
                                                MinHeight="28"
                                                Margin="0,0,8,0"
                                                BorderThickness="0" />
                                        <TextBlock Text="{DynamicResource Detect_Log}" FontFamily="{DynamicResource HeaderFontFamily}" FontSize="30" FontWeight="Bold" />
                                    </DockPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding DetectionLogEntries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="LogEntryBorder"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            CornerRadius="7"
                                                            Padding="0"
                                                            Margin="0,0,0,14">
                                                        <TextBlock x:Name="LogEntryText"
                                                                   Text="{Binding DisplayText}"
                                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                                   Foreground="{DynamicResource MutedInk}"
                                                                   TextWrapping="Wrap" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsEvent}" Value="True">
                                                            <Setter TargetName="LogEntryBorder" Property="Background" Value="#201E1A" />
                                                            <Setter TargetName="LogEntryBorder" Property="BorderBrush" Value="{DynamicResource Gold}" />
                                                            <Setter TargetName="LogEntryBorder" Property="BorderThickness" Value="3,0,0,0" />
                                                            <Setter TargetName="LogEntryBorder" Property="Padding" Value="14,8" />
                                                            <Setter TargetName="LogEntryText" Property="Foreground" Value="{DynamicResource Gold}" />
                                                            <Setter TargetName="LogEntryText" Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Bosses">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="48,38">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,46">
                            <TextBlock Text="{DynamicResource Bosses_CurrentEncounter}"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,0,0,20" />
                            <Border Background="{DynamicResource PanelAlt}"
                                    BorderBrush="#875432"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    Padding="34">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="Auto" MinWidth="150" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Common_ActiveEncounter}"
                                                   Style="{StaticResource LabelText}"
                                                   Margin="0,0,0,22" />
                                        <TextBlock Text="{Binding BossesActiveName}"
                                                   FontFamily="{DynamicResource HeaderFontFamily}"
                                                   FontSize="42"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding BossesActiveStartedText}"
                                                   Style="{StaticResource MutedText}"
                                                   FontStyle="Italic"
                                                   FontSize="16"
                                                   TextWrapping="Wrap"
                                                   Margin="0,18,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="#222220"
                                            BorderBrush="#38362F"
                                            BorderThickness="1"
                                            CornerRadius="11"
                                            Padding="26"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Bosses_DeathsRecorded}"
                                                       FontFamily="{DynamicResource AppFontFamily}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Ink}"
                                                       Margin="0,0,0,14" />
                                            <TextBlock Text="{Binding BossesActiveAttemptsText}"
                                                       Foreground="{DynamicResource Gold}"
                                                       FontFamily="{DynamicResource HeaderFontFamily}"
                                                       FontSize="34"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <Grid Margin="0,0,0,24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 1: title + primary action -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Bosses_ConqueredFoes}"
                                               Style="{StaticResource LabelText}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="{DynamicResource Bosses_AddRecord}"
                                            Command="{Binding OpenAddBossHistoryEditorCommand}"
                                            Style="{StaticResource GoldButton}"
                                            MinWidth="140"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <!-- Row 2: filter controls -->
                                <DockPanel Grid.Row="1" Margin="0,16,0,0" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{DynamicResource Bosses_SortBy}"
                                               Style="{StaticResource MutedText}"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <ComboBox DockPanel.Dock="Left"
                                              ItemsSource="{Binding BossSortModeOptions}"
                                              SelectedValue="{Binding SelectedBossSortMode, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource DarkComboBox}"
                                              FontSize="16"
                                              VerticalAlignment="Center"
                                              Width="140" />
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{DynamicResource Bosses_Direction}"
                                               Style="{StaticResource MutedText}"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="20,0,10,0" />
                                    <ComboBox DockPanel.Dock="Left"
                                              ItemsSource="{Binding BossSortDirectionOptions}"
                                              SelectedValue="{Binding SelectedBossSortDirection, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource DarkComboBox}"
                                              FontSize="16"
                                              VerticalAlignment="Center"
                                              Width="140" />
                                    <Border Background="{DynamicResource HeaderSurface}"
                                            BorderBrush="{DynamicResource BorderGold}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,8"
                                            VerticalAlignment="Center"
                                            Margin="20,0,0,0">
                                        <Grid>
                                            <TextBox Text="{Binding BossSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     FontSize="16" />
                                            <TextBlock Text="{DynamicResource Bosses_SearchPlaceholder}"
                                                       FontFamily="{DynamicResource AppFontFamily}"
                                                       FontSize="16"
                                                       Foreground="#6F675D"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BossSearchText}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DockPanel>
                            </Grid>
                            <TextBlock Text="{Binding DefeatedBossesEmptyText}"
                                       Style="{StaticResource MutedText}"
                                       FontStyle="Italic"
                                       Margin="0,0,0,16" />
                            <ItemsControl ItemsSource="{Binding DefeatedBosses}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="320" MinHeight="184" Margin="0,0,18,18">
                                            <!-- Decorative shadow layer: the effect rasterizes this empty
                                                 border only, keeping the card text crisp (ClearType). -->
                                            <Border Background="{DynamicResource Panel}"
                                                    CornerRadius="14">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16"
                                                                      Direction="270"
                                                                      ShadowDepth="2"
                                                                      Opacity="0.4"
                                                                      Color="#000000" />
                                                </Border.Effect>
                                            </Border>
                                            <Border Background="{DynamicResource Panel}"
                                                    BorderBrush="#34322C"
                                                    BorderThickness="1"
                                                    CornerRadius="14">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Height="4" CornerRadius="14,14,0,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#5E3E22" Offset="0" />
                                                            <GradientStop Color="#E08A3C" Offset="0.5" />
                                                            <GradientStop Color="#5E3E22" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="18,16,18,18">
                                                    <DockPanel Margin="0,0,0,16">
                                                        <Border DockPanel.Dock="Right"
                                                                Background="#201E1A"
                                                                BorderBrush="#5E3E22"
                                                                BorderThickness="1"
                                                                CornerRadius="9"
                                                                Padding="9,3"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding NumberText}"
                                                                       FontFamily="{DynamicResource AppFontFamily}"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       Foreground="#D2A099" />
                                                        </Border>
                                                        <Border Background="#222024"
                                                                BorderBrush="{DynamicResource Gold}"
                                                                BorderThickness="1"
                                                                CornerRadius="9"
                                                                Padding="10,4"
                                                                HorizontalAlignment="Left">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="✦"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource Gold}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0" />
                                                                <TextBlock Text="{DynamicResource Bosses_Felled}"
                                                                           FontFamily="{DynamicResource HeaderFontFamily}"
                                                                           FontSize="12"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource Gold}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontFamily="{DynamicResource HeaderFontFamily}"
                                                               FontSize="24"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Ink}"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                                        <Border Background="#1A1816"
                                                                BorderBrush="#2A2824"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="10,4"
                                                                Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding AttemptsText}"
                                                                       FontFamily="{DynamicResource AppFontFamily}"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource Ink}" />
                                                        </Border>
                                                        <Border Background="#1A1816"
                                                                BorderBrush="#2A2824"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="10,4">
                                                            <TextBlock Text="{Binding FightDurationText}"
                                                                       FontFamily="{DynamicResource AppFontFamily}"
                                                                       FontSize="13"
                                                                       Foreground="#978C84"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                    </StackPanel>
                                                    <DockPanel Margin="0,16,0,0" LastChildFill="False">
                                                        <Button DockPanel.Dock="Right"
                                                                Content="{DynamicResource Common_Edit}"
                                                                Command="{Binding DataContext.OpenBossHistoryEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource MiniEditButton}"
                                                                VerticalAlignment="Center" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding CompletedBy}"
                                                                       Style="{StaticResource LabelText}"
                                                                       FontSize="11"
                                                                       Foreground="#8F877A" />
                                                            <TextBlock Text="{Binding RecordedText}"
                                                                       FontFamily="{DynamicResource AppFontFamily}"
                                                                       FontSize="12"
                                                                       Foreground="#978C84"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Stats">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="48,38">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Stats_Title}"
                                           FontFamily="{DynamicResource HeaderFontFamily}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Gold}" />
                                <TextBlock Text="{DynamicResource Stats_Subtitle}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ExportStatusText}"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0" />
                                <Button Content="{DynamicResource Stats_ExportProfile}"
                                        Command="{Binding ExportProfileCommand}"
                                        Style="{StaticResource GoldButton}"
                                        MinWidth="170" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <UniformGrid Columns="2" Rows="4">
                                <Border Style="{StaticResource PanelBorder}" Margin="0,0,18,18">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Stats_TotalDeaths}" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding StatsTotalDeathsText}" FontFamily="{DynamicResource HeaderFontFamily}" FontSize="42" FontWeight="Bold" Foreground="{DynamicResource Gold}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Stats_DeathsToday}" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding StatsDeathsTodayText}" FontFamily="{DynamicResource HeaderFontFamily}" FontSize="42" FontWeight="Bold" Foreground="{DynamicResource Gold}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelBorder}" Margin="0,0,18,18">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Stats_SessionDeaths}" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding StatsSessionDeathsText}" FontFamily="{DynamicResource HeaderFontFamily}" FontSize="42" FontWeight="Bold" Foreground="{DynamicResource Gold}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Stats_DeathsPerHour}" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding StatsDeathsPerHourText}" FontFamily="{DynamicResource HeaderFontFamily}" FontSize="42" FontWeight="Bold" Foreground="{DynamicResource Gold}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelBorder}" Margin="0,0,18,18">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Stats_ActiveBoss}" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding StatsActiveBossText}" FontFamily="{DynamicResource HeaderFontFamily}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Stats_BestBoss}" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding StatsBestBossText}" FontFamily="{DynamicResource HeaderFontFamily}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelBorder}" Margin="0,0,18,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Stats_HardestBoss}" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding StatsHardestBossText}" FontFamily="{DynamicResource HeaderFontFamily}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Stats_LongestBoss}" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding StatsLongestBossText}" FontFamily="{DynamicResource HeaderFontFamily}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource Stats_RecentEvents}" Style="{StaticResource LabelText}" Margin="0,0,0,18" />
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding StatsRecentEvents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderGold}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,0,0,12"
                                                        Margin="0,0,0,14">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding TimestampText}" Style="{StaticResource MutedText}" />
                                                        <TextBlock Text="{Binding DetectionMethod}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding CountAfterText}" Foreground="{DynamicResource Gold}" FontFamily="{DynamicResource HeaderFontFamily}" FontSize="22" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="48,38">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,34">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_Title}"
                                           FontFamily="{DynamicResource HeaderFontFamily}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Gold}"
                                           Margin="0,0,22,0" />
                                <TextBlock Text="{DynamicResource Settings_Subtitle}"
                                           Style="{StaticResource MutedText}"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="{DynamicResource Settings_SaveSettings}"
                                    Command="{Binding SaveSettingsCommand}"
                                    Style="{StaticResource GoldButton}"
                                    MinWidth="170"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- OVERLAY -->
                            <Border Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_OverlaySection}" Style="{StaticResource LabelText}" Margin="0,0,0,24" />
                                    <CheckBox Content="{DynamicResource Settings_ShowOverlay}" IsChecked="{Binding OverlayEnabled}" Margin="0,0,0,4" />
                                    <TextBlock Text="{DynamicResource Settings_ShowOverlayDesc}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontStyle="Italic" Margin="0,0,0,22" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings_OverlayX}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" />
                                            <TextBox Text="{Binding OverlayXText, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="-10000|10000|0"
                                                     PreviewTextInput="NumericBox_PreviewTextInput"
                                                     DataObject.Pasting="NumericBox_Pasting"
                                                     LostFocus="NumericBox_LostFocus"
                                                     Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Settings_OverlayY}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" />
                                            <TextBox Text="{Binding OverlayYText, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="-10000|10000|0"
                                                     PreviewTextInput="NumericBox_PreviewTextInput"
                                                     DataObject.Pasting="NumericBox_Pasting"
                                                     LostFocus="NumericBox_LostFocus"
                                                     Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Settings_OverlayScale}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" Margin="0,24,0,0" />
                                    <TextBox Text="{Binding OverlayFontScaleInput, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="0.6|1.6|1"
                                             PreviewTextInput="NumericBox_PreviewTextInput"
                                             DataObject.Pasting="NumericBox_Pasting"
                                             LostFocus="NumericBox_LostFocus"
                                             Margin="0,6,0,0" />
                                    <TextBlock Text="{DynamicResource Settings_OverlayOpacity}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" Margin="0,24,0,0" />
                                    <TextBox Text="{Binding OverlayBackgroundOpacityInput, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="0|1|1"
                                             PreviewTextInput="NumericBox_PreviewTextInput"
                                             DataObject.Pasting="NumericBox_Pasting"
                                             LostFocus="NumericBox_LostFocus"
                                             Margin="0,6,0,14" />
                                    <CheckBox Content="{DynamicResource Settings_ShowBossTimer}" IsChecked="{Binding ShowBossTimer}" Margin="0,0,0,4" />
                                    <CheckBox Content="{DynamicResource Settings_ShowDetectionStatus}" IsChecked="{Binding ShowDetectionStatus}" />
                                </StackPanel>
                            </Border>

                            <!-- DETECTION -->
                            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_DetectionSection}" Style="{StaticResource LabelText}" Margin="0,0,0,24" />
                                    <TextBlock Text="{DynamicResource Settings_DetectionMode}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" />
                                    <ComboBox ItemsSource="{Binding DetectionModeOptions}"
                                              SelectedValue="{Binding SelectedDetectionModeValue, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource DarkComboBox}"
                                              Margin="0,6,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings_DetectionInterval}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" />
                                            <TextBox Text="{Binding DetectionIntervalMsText, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="250|5000|0"
                                                     PreviewTextInput="NumericBox_PreviewTextInput"
                                                     DataObject.Pasting="NumericBox_Pasting"
                                                     LostFocus="NumericBox_LostFocus"
                                                     Margin="0,6,0,4" />
                                            <TextBlock Text="{DynamicResource Settings_DetectionIntervalHint}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontStyle="Italic" FontSize="12" Margin="0,0,0,18" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Settings_Cooldown}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" />
                                            <TextBox Text="{Binding DetectionCooldownSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="1|300|0"
                                                     PreviewTextInput="NumericBox_PreviewTextInput"
                                                     DataObject.Pasting="NumericBox_Pasting"
                                                     LostFocus="NumericBox_LostFocus"
                                                     Margin="0,6,0,4" />
                                            <TextBlock Text="{DynamicResource Settings_CooldownHint}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontStyle="Italic" FontSize="12" Margin="0,0,0,18" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Settings_Sensitivity}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" />
                                    <TextBox Text="{Binding DetectionSensitivityText, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="0.1|1|2"
                                             PreviewTextInput="NumericBox_PreviewTextInput"
                                             DataObject.Pasting="NumericBox_Pasting"
                                             LostFocus="NumericBox_LostFocus"
                                             Margin="0,6,0,4" />
                                    <TextBlock Text="{DynamicResource Settings_SensitivityHint}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontStyle="Italic" FontSize="12" Margin="0,0,0,18" />
                                    <Button Content="{DynamicResource Settings_ResetDetectionDefaults}"
                                            Command="{Binding ResetDetectionSettingsCommand}"
                                            Margin="0,0,0,18" />
                                    <TextBlock Text="{DynamicResource Settings_CaptureRegion}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" />
                                    <ComboBox ItemsSource="{Binding CaptureTargetOptions}"
                                              SelectedValue="{Binding SelectedCaptureTargetValue, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource DarkComboBox}"
                                              Margin="0,6,0,14" />
                                    <TextBlock Text="{DynamicResource Settings_BossHealthBarStyle}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" />
                                    <ComboBox ItemsSource="{Binding BossHealthBarStyleOptions}"
                                              SelectedValue="{Binding SelectedBossHealthBarStyleValue, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource DarkComboBox}"
                                              Margin="0,6,0,14" />
                                    <CheckBox Content="{DynamicResource Settings_StartDetectionOnLaunch}" IsChecked="{Binding DetectionEnabledOnStartup}" />
                                    <CheckBox Content="{DynamicResource Settings_DetectDeaths}" IsChecked="{Binding DetectDeaths}" />
                                    <CheckBox Content="{DynamicResource Settings_DetectBossVictories}" IsChecked="{Binding DetectBossVictories}" />
                                    <CheckBox Content="{DynamicResource Settings_AutoReadBossName}" IsChecked="{Binding AutoDetectBossNames}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- CHARACTER & SAVE GAME -->
                            <Border Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_CharacterSection}" Style="{StaticResource LabelText}" Margin="0,0,0,16" />
                                    <TextBlock Text="{DynamicResource Settings_CharacterDesc}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" Margin="0,0,0,12" />
                                    <TextBlock Text="{DynamicResource Settings_CharacterName}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding CharacterProfileNameText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                                    <Button Content="{DynamicResource Settings_UseProfile}"
                                            Command="{Binding ApplyCharacterProfileCommand}"
                                            Style="{StaticResource GoldButton}" />
                                </StackPanel>
                            </Border>

                            <!-- LANGUAGE -->
                            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_LanguageSection}" Style="{StaticResource LabelText}" Margin="0,0,0,16" />
                                    <TextBlock Text="{DynamicResource Settings_LanguageDesc}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" Margin="0,0,0,12" />
                                    <ComboBox ItemsSource="{Binding GameLanguageOptions}"
                                              SelectedValue="{Binding SelectedGameLanguageValue, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource DarkComboBox}" />
                                    <TextBlock Text="{DynamicResource Settings_AppLanguageSection}" Style="{StaticResource LabelText}" Margin="0,24,0,16" />
                                    <TextBlock Text="{DynamicResource Settings_AppLanguageDesc}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" Margin="0,0,0,12" />
                                    <ComboBox ItemsSource="{Binding AppLanguageOptions}"
                                              SelectedValue="{Binding SelectedAppLanguageValue, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource DarkComboBox}" />
                                </StackPanel>
                            </Border>

                            <!-- HOTKEYS -->
                            <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_HotkeysSection}" Style="{StaticResource LabelText}" Margin="0,0,0,20" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="84" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource Settings_HotkeyAddDeath}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding ManualAddHotkeyText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="0,0,0,14"
                                                 IsReadOnly="True" Cursor="Hand" ToolTip="{DynamicResource Settings_HotkeyPrompt}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                        <TextBlock Grid.Row="1" Text="{DynamicResource Settings_HotkeySubtractDeath}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ManualSubtractHotkeyText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="0,0,0,14"
                                                 IsReadOnly="True" Cursor="Hand" ToolTip="{DynamicResource Settings_HotkeyPrompt}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                        <TextBlock Grid.Row="2" Text="{DynamicResource Settings_HotkeyBossKill}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ManualBossDefeatedHotkeyText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="0,0,0,14"
                                                 IsReadOnly="True" Cursor="Hand" ToolTip="{DynamicResource Settings_HotkeyPrompt}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                        <TextBlock Grid.Row="3" Text="{DynamicResource Settings_HotkeyToggleOverlay}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OverlayToggleHotkeyText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="0,0,0,14"
                                                 IsReadOnly="True" Cursor="Hand" ToolTip="{DynamicResource Settings_HotkeyPrompt}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                        <TextBlock Grid.Row="4" Text="{DynamicResource Common_ToggleDetection}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DetectionToggleHotkeyText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="0,0,0,14"
                                                 IsReadOnly="True" Cursor="Hand" ToolTip="{DynamicResource Settings_HotkeyPrompt}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                        <TextBlock Grid.Row="5" Text="{DynamicResource Common_SkipBoss}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding BossSkipHotkeyText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"
                                                 IsReadOnly="True" Cursor="Hand" ToolTip="{DynamicResource Settings_HotkeyPrompt}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- PROFILE / SAVE GAME -->
                        <Border Grid.Row="3" Style="{StaticResource PanelBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_ProfileSection}" Style="{StaticResource LabelText}" Margin="0,0,0,16" />
                                <TextBlock Text="{DynamicResource Settings_ProfileDesc}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource AppFontFamily}" Margin="0,0,0,12" />
                                <TextBox Text="{Binding DataFolderPathText, UpdateSourceTrigger=PropertyChanged}" />
                                <DockPanel Margin="0,18,0,0" LastChildFill="False">
                                    <Button Content="{DynamicResource Settings_OpenProfileFolder}"
                                            Command="{Binding OpenDataFolderCommand}"
                                            MinWidth="150"
                                            Margin="0,0,12,0" />
                                    <Button Content="{DynamicResource Settings_ResetProfileDefaults}"
                                            Command="{Binding ResetProfileSettingsCommand}"
                                            Style="{StaticResource DangerButton}"
                                            MinWidth="180" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Column="1"
                Grid.Row="1"
                Background="#A0000000"
                Visibility="{Binding IsBossHistoryEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="430"
                    Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource BorderGold}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28"
                                      Direction="270"
                                      ShadowDepth="3"
                                      Opacity="0.55"
                                      Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding BossHistoryEditorTitle}"
                               Style="{StaticResource LabelText}"
                               Margin="0,0,0,18" />
                    <TextBlock Text="{DynamicResource Editor_Name}"
                               Style="{StaticResource MutedText}"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontWeight="Bold" />
                    <TextBox Text="{Binding BossEditNameText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Editor_Attempts}"
                                       Style="{StaticResource MutedText}"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       FontWeight="Bold" />
                            <TextBox Text="{Binding BossEditAttemptsText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,14" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Editor_Duration}"
                                       Style="{StaticResource MutedText}"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       FontWeight="Bold" />
                            <TextBox Text="{Binding BossEditDurationText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,14" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource Editor_RecordedAt}"
                               Style="{StaticResource MutedText}"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontWeight="Bold" />
                    <TextBox Text="{Binding BossEditRecordedAtText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,14" />
                    <TextBlock Text="{DynamicResource Editor_CompletedBy}"
                               Style="{StaticResource MutedText}"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontWeight="Bold" />
                    <TextBox Text="{Binding BossEditCompletedByText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,22" />
                    <DockPanel LastChildFill="False">
                        <Button Content="{DynamicResource Common_Delete}"
                                Command="{Binding DeleteBossHistoryEditorCommand}"
                                Style="{StaticResource DangerButton}"
                                MinWidth="100"
                                Margin="0,0,12,0"
                                Visibility="{Binding CanDeleteBossHistoryEntry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="{DynamicResource Common_Cancel}"
                                Command="{Binding CancelBossHistoryEditorCommand}"
                                MinWidth="100"
                                Margin="0,0,12,0" />
                        <Button DockPanel.Dock="Right"
                                Content="{DynamicResource Common_Save}"
                                Command="{Binding SaveBossHistoryEditorCommand}"
                                IsDefault="True"
                                Style="{StaticResource GoldButton}"
                                MinWidth="118" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>
